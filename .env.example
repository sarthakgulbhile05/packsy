# Copy to .env.local and fill in. Never commit .env.local.

# Supabase dashboard → Project Settings → API Keys (publishable key only — never the secret key).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# This app's own address, used for links in confirmation emails. https in production.
SITE_URL=http://localhost:3000

# Cloudflare Turnstile. These are Cloudflare's public TEST keys (always pass) — development only.
# Production needs real keys from the Cloudflare dashboard; the secret stays server-side.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
